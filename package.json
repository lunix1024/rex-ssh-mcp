{
  "name": "rex-ssh-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "MCP server for managing multiple remote Linux hosts over SSH with Windows DPAPI-protected credentials",
  "license": "MIT",
  "author": "lunix1024",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunix1024/rex-ssh-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/lunix1024/rex-ssh-mcp/issues"
  },
  "homepage": "https://github.com/lunix1024/rex-ssh-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ssh",
    "sftp",
    "remote-server",
    "dpapi"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "config": "npm run build --silent && node dist/config-cli.js",
    "test": "npm run build && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.10.1",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
